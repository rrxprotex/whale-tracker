# === Application ===
APP_NAME=WhaleTracker
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./whale_tracker.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/whale_tracker

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# === US Market Data ===
# Alpha Vantage (free tier: 25 requests/day)
ALPHA_VANTAGE_API_KEY=your_key_here

# Polygon.io (real-time US data)
POLYGON_API_KEY=your_key_here

# === Turkish Market ===
# Midas API
MIDAS_API_KEY=your_key_here

# === Crypto ===
# Binance
BINANCE_API_KEY=your_key_here
BINANCE_SECRET_KEY=your_secret_here

# Coinbase
COINBASE_API_KEY=your_key_here
COINBASE_SECRET_KEY=your_secret_here

# === Whale Detection Thresholds ===
# Minimum trade size to consider as "whale" trade (in USD)
WHALE_THRESHOLD_US=1000000
WHALE_THRESHOLD_TURKEY=5000000  # TL
WHALE_THRESHOLD_CRYPTO=100000   # USD equivalent

# Volume spike multiplier (e.g., 3.0 = 3x average volume)
VOLUME_SPIKE_MULTIPLIER=3.0
